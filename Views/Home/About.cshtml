@model LogisticManagementSystem.Models.EnquiryModel

@{
    ViewBag.Title = "ABOUT US";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ONESPOT ABOUT PAGE - DESIGN OPTION 2 */
    #osl-about-v2 {
        --navy: #071b35;
        --blue: #123456;
        --orange: #ff8c24;
        --light: #f4f7fb;
        --text: #58677a;
        font-family: "Segoe UI", Arial, sans-serif;
        color: var(--navy);
        overflow: hidden;
    }

        #osl-about-v2 *,
        #osl-about-v2 *::before,
        #osl-about-v2 *::after {
            box-sizing: border-box;
        }

        #osl-about-v2 .osl-wrap {
            width: 100%;
            max-width: 1320px;
            margin: 0 auto;
            padding: 0 25px;
        }

        /* SPLIT HERO */
        #osl-about-v2 .osl-hero {
            padding: 65px 0;
            background: radial-gradient(circle at 90% 10%, rgba(255, 140, 36, .14), transparent 35%), linear-gradient(135deg, #f8fafc, #edf3fa);
        }

        #osl-about-v2 .osl-kicker {
            display: inline-block;
            margin-bottom: 18px;
            padding: 9px 15px;
            color: #b96310;
            background: #fff0df;
            border-radius: 30px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        #osl-about-v2 .osl-hero h1 {
            margin: 0 0 20px;
            font-size: clamp(34px, 4.2vw, 54px);
            font-weight: 850;
            line-height: 1.13;
            letter-spacing: -1.3px;
            color: var(--navy);
        }

            #osl-about-v2 .osl-hero h1 span {
                color: var(--orange);
            }

        #osl-about-v2 .osl-hero-copy {
            color: var(--text);
            font-size: 15px;
            line-height: 1.95;
            margin-bottom: 25px;
        }

        #osl-about-v2 .osl-promise {
            display: flex;
            align-items: flex-start;
            gap: 13px;
            margin-top: 20px;
        }

        #osl-about-v2 .osl-promise-mark {
            flex: 0 0 38px;
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: var(--navy);
            color: white;
            font-size: 17px;
            font-weight: 800;
        }

        #osl-about-v2 .osl-promise strong {
            display: block;
            margin-bottom: 4px;
            font-size: 14px;
            color: var(--navy);
        }

        #osl-about-v2 .osl-promise p {
            margin: 0;
            font-size: 13px;
            line-height: 1.7;
            color: var(--text);
        }

        /* HERO IMAGE PANEL */
        #osl-about-v2 .osl-visual {
            position: relative;
            margin-top: 12px;
            padding: 12px;
            border-radius: 20px;
            background: white;
            box-shadow: 0 22px 55px rgba(7, 27, 53, .14);
        }

        #osl-about-v2 .osl-visual-accent {
            position: absolute;
            top: -12px;
            right: -10px;
            width: 100px;
            height: 100px;
            background: var(--orange);
            border-radius: 18px;
            z-index: 0;
        }

        #osl-about-v2 .osl-visual-inner {
            position: relative;
            z-index: 1;
            overflow: hidden;
            border-radius: 13px;
        }

        /* EXISTING BOOTSTRAP 3 CAROUSEL */
        #osl-about-v2 #myCarousel {
            margin: 0;
        }

            #osl-about-v2 #myCarousel .carousel-inner {
                border-radius: 13px;
                overflow: hidden;
                background: var(--navy);
            }

            #osl-about-v2 #myCarousel .item {
                position: relative;
                background: var(--navy);
            }

                #osl-about-v2 #myCarousel .item > img {
                    width: 100%;
                    height: 450px;
                    display: block;
                    object-fit: cover;
                    object-position: center;
                    opacity: .83;
                }

                #osl-about-v2 #myCarousel .item::after {
                    content: "";
                    position: absolute;
                    inset: 0;
                    pointer-events: none;
                    background: linear-gradient( 0deg, rgba(4, 17, 34, .91), rgba(4, 17, 34, .08) 80% );
                }

        #osl-about-v2 .osl-slide-caption {
            position: absolute;
            z-index: 2;
            left: 25px;
            right: 25px;
            bottom: 50px;
            color: white;
        }

            #osl-about-v2 .osl-slide-caption small {
                display: block;
                margin-bottom: 10px;
                color: #ffb76f;
                font-size: 11px;
                font-weight: 800;
                letter-spacing: 2px;
                text-transform: uppercase;
            }

            #osl-about-v2 .osl-slide-caption h2 {
                margin: 0 0 10px;
                color: white;
                font-size: clamp(23px, 2.6vw, 32px);
                font-weight: 800;
                line-height: 1.25;
            }

            #osl-about-v2 .osl-slide-caption p {
                margin: 0;
                color: #edf3fa;
                font-size: 13px;
                line-height: 1.7;
            }

        #osl-about-v2 #myCarousel .carousel-indicators {
            z-index: 3;
            bottom: 8px;
        }

            #osl-about-v2 #myCarousel .carousel-indicators li {
                width: 8px;
                height: 8px;
                margin: 2px 4px;
                background: rgba(255, 255, 255, .45);
                border: 1px solid white;
            }

                #osl-about-v2 #myCarousel .carousel-indicators li.active {
                    width: 23px;
                    height: 8px;
                    margin: 2px 4px;
                    border-radius: 10px;
                    background: var(--orange);
                    border-color: var(--orange);
                }

        #osl-about-v2 #myCarousel .carousel-control {
            width: 12%;
            z-index: 3;
            opacity: .85;
            background: none;
            text-shadow: none;
        }

            #osl-about-v2 #myCarousel .carousel-control:hover {
                opacity: 1;
            }

        #osl-about-v2 #myCarousel .glyphicon {
            color: white;
        }

        /* COMPANY INTRO */
        #osl-about-v2 .osl-story {
            padding: 85px 0;
            background: white;
        }

        #osl-about-v2 .osl-label {
            display: block;
            margin-bottom: 12px;
            color: #c96b15;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        #osl-about-v2 .osl-heading {
            margin: 0 0 22px;
            font-size: clamp(29px, 3.3vw, 41px);
            line-height: 1.25;
            font-weight: 800;
            color: var(--navy);
        }

            #osl-about-v2 .osl-heading span {
                color: var(--orange);
            }

        #osl-about-v2 .osl-copy {
            color: var(--text);
            font-size: 14px;
            line-height: 2;
        }

            #osl-about-v2 .osl-copy p {
                margin-bottom: 17px;
            }

        #osl-about-v2 .osl-story-panel {
            padding: 30px;
            background: var(--light);
            border-radius: 15px;
            border-top: 4px solid var(--orange);
        }

            #osl-about-v2 .osl-story-panel h3 {
                margin: 0 0 15px;
                font-size: 21px;
                font-weight: 800;
                color: var(--navy);
            }

            #osl-about-v2 .osl-story-panel p {
                margin: 0;
                color: var(--text);
                font-size: 14px;
                line-height: 1.95;
            }

        /* VALUES STRIP */
        #osl-about-v2 .osl-values {
            padding: 75px 0;
            background: var(--light);
        }

        #osl-about-v2 .osl-section-head {
            margin-bottom: 40px;
            text-align: center;
        }

        #osl-about-v2 .osl-value {
            position: relative;
            min-height: 205px;
            padding: 28px 23px;
            margin-bottom: 24px;
            background: white;
            border: 1px solid #e4eaf2;
            border-radius: 12px;
            transition: transform .25s ease, box-shadow .25s ease;
        }

            #osl-about-v2 .osl-value:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 32px rgba(7, 27, 53, .09);
            }

        #osl-about-v2 .osl-value-index {
            color: var(--orange);
            font-size: 30px;
            line-height: 1;
            font-weight: 850;
        }

        #osl-about-v2 .osl-value h3 {
            margin: 20px 0 10px;
            font-size: 17px;
            font-weight: 800;
            color: var(--navy);
        }

        #osl-about-v2 .osl-value p {
            margin: 0;
            color: var(--text);
            font-size: 13px;
            line-height: 1.85;
        }

        /* DARK BRAND SECTION */
        #osl-about-v2 .osl-commitment {
            position: relative;
            padding: 80px 0;
            background: var(--navy);
            color: white;
        }

            #osl-about-v2 .osl-commitment .osl-heading {
                color: white;
            }

            #osl-about-v2 .osl-commitment .osl-copy {
                color: #d4deea;
            }

        #osl-about-v2 .osl-checklist {
            padding: 0;
            margin: 25px 0 0;
            list-style: none;
        }

            #osl-about-v2 .osl-checklist li {
                position: relative;
                padding: 14px 10px 14px 35px;
                border-bottom: 1px solid rgba(255, 255, 255, .14);
                color: #edf3fa;
                font-size: 14px;
                line-height: 1.7;
            }

                #osl-about-v2 .osl-checklist li::before {
                    content: "\2713";
                    position: absolute;
                    left: 5px;
                    top: 13px;
                    color: var(--orange);
                    font-size: 18px;
                    font-weight: 900;
                }

        #osl-about-v2 .osl-commitment-panel {
            padding: 32px;
            border: 1px solid rgba(255, 255, 255, .16);
            border-radius: 14px;
            background: rgba(255, 255, 255, .06);
        }

            #osl-about-v2 .osl-commitment-panel h3 {
                margin: 0 0 17px;
                color: white;
                font-size: 23px;
                font-weight: 800;
            }

            #osl-about-v2 .osl-commitment-panel p {
                color: #d4deea;
                font-size: 14px;
                line-height: 2;
            }

        #osl-about-v2 .osl-orange-rule {
            width: 52px;
            height: 4px;
            margin-bottom: 23px;
            background: var(--orange);
            border-radius: 5px;
        }

        /* ENQUIRY */
        #osl-about-v2 .osl-enquiry {
            padding: 75px 0;
            background: #f4f7fb;
        }

        #osl-about-v2 .osl-enquiry-head {
            margin-bottom: 30px;
            text-align: center;
        }

            #osl-about-v2 .osl-enquiry-head p {
                color: var(--text);
                font-size: 14px;
                line-height: 1.8;
            }

    /* RESPONSIVE */
    @@media (max-width: 767px) {
        #osl-about-v2 .osl-wrap {
            padding: 0 16px;
        }

        #osl-about-v2 .osl-hero {
            padding: 40px 0 50px;
        }

            #osl-about-v2 .osl-hero h1 {
                letter-spacing: -.5px;
            }

        #osl-about-v2 .osl-visual {
            margin-top: 35px;
        }

        #osl-about-v2 #myCarousel .item > img {
            height: 350px;
        }

        #osl-about-v2 .osl-slide-caption {
            left: 18px;
            right: 18px;
            bottom: 45px;
        }

            #osl-about-v2 .osl-slide-caption h2 {
                font-size: 24px;
            }

            #osl-about-v2 .osl-slide-caption p {
                font-size: 12px;
            }

        #osl-about-v2 .osl-story,
        #osl-about-v2 .osl-values,
        #osl-about-v2 .osl-commitment,
        #osl-about-v2 .osl-enquiry {
            padding: 55px 0;
        }

        #osl-about-v2 .osl-story-panel,
        #osl-about-v2 .osl-commitment-panel {
            padding: 24px;
            margin-top: 20px;
        }

        #osl-about-v2 .osl-value {
            min-height: 0;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        #osl-about-v2 *,
        #osl-about-v2 *::before,
        #osl-about-v2 *::after {
            transition: none !important;
            animation: none !important;
        }
    }
</style>

<div id="osl-about-v2">

    <!-- SPLIT HERO -->
