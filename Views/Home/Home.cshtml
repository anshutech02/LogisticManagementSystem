                        </div>

                        <div class="item">
                            <img src="@Url.Content("~/Image/man running on graph.jpg")"
                                 alt="Business growth and performance" />

                            <div class="osl-slide-content">
                                <span class="osl-slide-label">
                                    Business Growth
                                </span>
                                <h2>Built for Better Performance</h2>
                                <p>
                                    Support business growth with
                                    streamlined workflows and a focus
                                    on operational efficiency.
                                </p>
                            </div>
                        </div>

                        <div class="item">
                            <img src="@Url.Content("~/Image/logistics.jpg")"
                                 alt="Logistics and supply chain management" />

                            <div class="osl-slide-content">
                                <span class="osl-slide-label">
                                    Supply Chain Solutions
                                </span>
                                <h2>Connecting Every Destination</h2>
                                <p>
                                    Make logistics coordination easier
                                    through connected processes and
                                    dependable transportation planning.
                                </p>
                            </div>
                        </div>

                        <div class="item">
                            <img src="@Url.Content("~/Image/LogisticBlog.jpg")"
                                 alt="Logistics management and transportation" />

                            <div class="osl-slide-content">
                                <span class="osl-slide-label">
                                    Modern Logistics
                                </span>
                                <h2>Efficiency at Every Step</h2>
                                <p>
                                    Discover a more organized approach
                                    to logistics, freight coordination,
                                    and transportation management.
                                </p>
                            </div>
                        </div>

                    </div>

                    <!-- Previous Control -->
                    <a class="left carousel-control"
                       href="#myCarousel"
                       role="button"
                       data-slide="prev"
                       aria-label="Previous slide">

                        <span class="glyphicon glyphicon-chevron-left"
                              aria-hidden="true"></span>
                        <span class="sr-only">Previous</span>
                    </a>

                    <!-- Next Control -->
                    <a class="right carousel-control"
                       href="#myCarousel"
                       role="button"
                       data-slide="next"
                       aria-label="Next slide">

                        <span class="glyphicon glyphicon-chevron-right"
                              aria-hidden="true"></span>
                        <span class="sr-only">Next</span>
                    </a>

                </div>
            </div>

        </div>
    </section>

    <!-- INTRODUCTION AND FEATURES -->
