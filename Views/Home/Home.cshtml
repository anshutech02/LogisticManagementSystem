@model LogisticManagementSystem.Models.EnquiryModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Home";
}

<style>
    /* ===============================
       ONESPOT LOGISTIC - HOME PAGE
       All styles scoped to this page
       =============================== */

    #osl-home {
        --osl-navy: #071b35;
        --osl-blue: #102f52;
        --osl-orange: #ff8c24;
        --osl-light: #f4f7fb;
        --osl-text: #526176;
        color: var(--osl-navy);
        font-family: "Segoe UI", Arial, sans-serif;
        overflow: hidden;
    }

    #osl-home * {
        box-sizing: border-box;
    }

    #osl-home .osl-container {
        width: 100%;
        max-width: 1320px;
        margin: 0 auto;
        padding: 0 25px;
    }

    /* HERO SECTION */

    #osl-home .osl-hero {
        position: relative;
        padding: 40px 0 55px;
        background:
            radial-gradient(ellipse at top right,
                rgba(255, 140, 36, 0.13), transparent 45%),
            linear-gradient(135deg, #f8fafc, #edf3fa);
    }

    #osl-home .osl-eyebrow {
        display: inline-block;
        padding: 9px 16px;
        margin-bottom: 20px;
        color: #c96a12;
        background: #fff0df;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.8px;
        text-transform: uppercase;
    }

    #osl-home .osl-hero-title {
        margin: 0 0 18px;
        color: var(--osl-navy);
        font-size: clamp(32px, 4vw, 55px);
        line-height: 1.14;
        font-weight: 800;
        letter-spacing: -1.4px;
    }

    #osl-home .osl-hero-title span {
        color: var(--osl-orange);
    }

    #osl-home .osl-hero-description {
        max-width: 580px;
        margin: 0 0 25px;
        color: var(--osl-text);
        font-size: 16px;
        line-height: 1.9;
    }

    #osl-home .osl-trust-line {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 22px;
        margin-top: 24px;
        color: var(--osl-blue);
        font-size: 13px;
        font-weight: 600;
    }

    #osl-home .osl-trust-line span::before {
        content: "\2713";
        display: inline-block;
        margin-right: 7px;
        color: #e77b16;
        font-weight: 900;
    }

    /* CAROUSEL */

    #osl-home .osl-carousel-frame {
        position: relative;
        margin-top: 30px;
        overflow: hidden;
        border-radius: 18px;
        background: var(--osl-navy);
        box-shadow: 0 24px 60px rgba(7, 27, 53, 0.20);
    }

    #osl-home #myCarousel {
        margin-bottom: 0;
    }

    #osl-home #myCarousel .carousel-inner {
        border-radius: 18px;
        overflow: hidden;
    }

    #osl-home #myCarousel .item {
        position: relative;
        background: var(--osl-navy);
    }

    #osl-home #myCarousel .item > img {
        display: block;
        width: 100%;
        height: 510px;
        object-fit: cover;
        object-position: center;
        opacity: 0.82;
    }

    #osl-home #myCarousel .item::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(
            90deg,
            rgba(4, 18, 36, 0.88) 0%,
            rgba(4, 18, 36, 0.48) 48%,
            rgba(4, 18, 36, 0.05) 100%
        );
    }

    #osl-home .osl-slide-content {
        position: absolute;
        z-index: 2;
        top: 50%;
        left: 7%;
        right: 8%;
        transform: translateY(-50%);
        max-width: 600px;
        color: #fff;
    }

    #osl-home .osl-slide-label {
        display: inline-block;
        padding: 8px 13px;
        margin-bottom: 16px;
        color: #fff;
        background: rgba(255, 140, 36, 0.96);
        border-radius: 4px;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    #osl-home .osl-slide-content h2 {
        margin: 0 0 14px;
        color: #fff;
        font-size: clamp(27px, 3.5vw, 45px);
        font-weight: 800;
        line-height: 1.15;
        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.18);
    }

    #osl-home .osl-slide-content p {
        max-width: 500px;
        margin: 0;
        color: #edf3fa;
        font-size: 15px;
        line-height: 1.8;
    }

    #osl-home #myCarousel .carousel-indicators {
        z-index: 4;
        bottom: 13px;
    }

    #osl-home #myCarousel .carousel-indicators li {
        width: 9px;
        height: 9px;
        margin: 2px 4px;
        border: 1px solid #fff;
        background: rgba(255, 255, 255, 0.45);
    }

    #osl-home #myCarousel .carousel-indicators li.active {
        width: 25px;
        height: 9px;
        margin: 2px 4px;
        border: 1px solid var(--osl-orange);
        border-radius: 10px;
        background: var(--osl-orange);
    }

    #osl-home #myCarousel .carousel-control {
        z-index: 3;
        width: 7%;
        opacity: 0.8;
        background: none;
        text-shadow: none;
    }

    #osl-home #myCarousel .carousel-control:hover {
        opacity: 1;
    }

    #osl-home #myCarousel .glyphicon {
        color: #fff;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }

    /* INTRODUCTION */

    #osl-home .osl-intro {
        padding: 85px 0;
        background: #fff;
    }

    #osl-home .osl-section-tag {
        display: block;
        margin-bottom: 12px;
        color: #d97617;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    #osl-home .osl-section-title {
        margin: 0 0 22px;
        color: var(--osl-navy);
        font-size: clamp(29px, 3.5vw, 42px);
        line-height: 1.25;
        font-weight: 800;
    }

    #osl-home .osl-section-title span {
        color: var(--osl-orange);
    }

    #osl-home .osl-intro-text {
        color: var(--osl-text);
        font-size: 15px;
        line-height: 2;
    }

    #osl-home .osl-feature-card {
        height: 100%;
        min-height: 175px;
        padding: 25px;
        margin-top: 25px;
        background: #fff;
        border: 1px solid #e8edf4;
        border-radius: 12px;
        box-shadow: 0 8px 25px rgba(7, 27, 53, 0.045);
        transition: transform 0.25s ease,
                    box-shadow 0.25s ease;
    }

    #osl-home .osl-feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(7, 27, 53, 0.10);
    }

    #osl-home .osl-feature-number {
        display: inline-block;
        margin-bottom: 15px;
        color: var(--osl-orange);
        font-size: 28px;
        font-weight: 800;
    }

    #osl-home .osl-feature-card h3 {
        margin: 0 0 10px;
        color: var(--osl-navy);
        font-size: 18px;
        font-weight: 750;
    }

    #osl-home .osl-feature-card p {
        margin: 0;
        color: var(--osl-text);
        font-size: 13px;
        line-height: 1.8;
    }

    /* HOW IT WORKS */

    #osl-home .osl-how {
        position: relative;
        padding: 85px 0;
        color: #fff;
        background-color: #071b35;
        background-image:
            linear-gradient(
                90deg,
                rgba(4, 17, 34, 0.95),
                rgba(4, 17, 34, 0.78)
            ),
            url('@Url.Content("~/Image/LogiticwareHouse.jpg")');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    #osl-home .osl-how .osl-section-title {
        color: #fff;
    }

    #osl-home .osl-how .osl-intro-text {
        color: #dbe4ef;
    }

    #osl-home .osl-how-points {
        margin-top: 28px;
    }

    #osl-home .osl-how-point {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        padding: 19px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    }

    #osl-home .osl-how-point:last-child {
        border-bottom: 0;
    }

    #osl-home .osl-how-icon {
        display: flex;
        flex: 0 0 42px;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        color: #fff;
        background: var(--osl-orange);
        border-radius: 10px;
        font-size: 17px;
        font-weight: 800;
    }

    #osl-home .osl-how-point h3 {
        margin: 2px 0 8px;
        color: #fff;
        font-size: 17px;
        font-weight: 700;
    }

    #osl-home .osl-how-point p {
        margin: 0;
        color: #cbd7e5;
        font-size: 13px;
        line-height: 1.8;
    }

    #osl-home .osl-how-panel {
        padding: 35px;
        margin-top: 20px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.17);
        border-radius: 16px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);
    }

    #osl-home .osl-how-panel h3 {
        margin: 0 0 18px;
        color: #fff;
        font-size: 23px;
        font-weight: 750;
    }

    #osl-home .osl-how-panel p {
        color: #dbe4ef;
        font-size: 14px;
        line-height: 2;
    }

    #osl-home .osl-accent-line {
        width: 55px;
        height: 4px;
        margin: 0 0 22px;
        background: var(--osl-orange);
        border-radius: 5px;
    }

    /* ENQUIRY AREA */

    #osl-home .osl-enquiry-section {
        padding: 75px 0;
        background: var(--osl-light);
    }

    #osl-home .osl-enquiry-heading {
        margin-bottom: 30px;
        text-align: center;
    }

    #osl-home .osl-enquiry-heading p {
        color: var(--osl-text);
        font-size: 15px;
        line-height: 1.8;
    }

    /* RESPONSIVE DESIGN */

    @@media (max-width: 767px) {
        #osl-home .osl-container {
            padding: 0 16px;
        }

        #osl-home .osl-hero {
            padding: 30px 0 35px;
        }

        #osl-home .osl-hero-title {
            letter-spacing: -0.6px;
        }

        #osl-home .osl-hero-description {
            font-size: 14px;
        }

        #osl-home .osl-carousel-frame {
            margin-top: 25px;
            border-radius: 12px;
        }

        #osl-home #myCarousel .carousel-inner {
            border-radius: 12px;
        }

        #osl-home #myCarousel .item > img {
            height: 360px;
        }

        #osl-home .osl-slide-content {
            left: 8%;
            right: 8%;
        }

        #osl-home .osl-slide-content h2 {
            font-size: 27px;
        }

        #osl-home .osl-slide-content p {
            font-size: 13px;
            line-height: 1.6;
        }

        #osl-home .osl-slide-label {
            margin-bottom: 12px;
            font-size: 10px;
        }

        #osl-home .osl-intro,
        #osl-home .osl-how,
        #osl-home .osl-enquiry-section {
            padding: 55px 0;
        }

        #osl-home .osl-feature-card {
            min-height: 0;
        }

        #osl-home .osl-how-panel {
            padding: 25px 20px;
        }

        #osl-home #myCarousel .carousel-control {
            width: 10%;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        #osl-home *,
        #osl-home *::before,
        #osl-home *::after {
            animation: none !important;
            transition: none !important;
            scroll-behavior: auto !important;
        }
    }
</style>

<div id="osl-home">

    <!-- HERO SECTION -->
    <section class="osl-hero">
        <div class="osl-container">

            <div class="row">
